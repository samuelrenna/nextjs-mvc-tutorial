# ============================================
# COPIA ESTE ARCHIVO COMO .env Y AJUSTA LOS VALORES
# ============================================
# cp .env.example .env
#
# Los valores por defecto coinciden con docker-compose.yml
# así que si usas Docker, solo necesitas copiar y listo.

# Base de datos (coincide con docker-compose.yml)
DATABASE_URL="mysql://root:root1234@localhost:3306/mvc_blog"

# Clave secreta para sesiones (mínimo 32 caracteres)
SESSION_SECRET="cambia-esto-por-una-clave-secreta-de-32-caracteres"

# URL de la aplicación
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="MVC Blog Tutorial"
